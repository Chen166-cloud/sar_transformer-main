# Copy this file outside version control, replace both /SET/... placeholders, then:
#   source /path/to/your/env.server
# Do not assume the 50-GB data disk's mount point; confirm it with lsblk/df first.

export SAR_PROJECT_ROOT="/SET/PROJECT_ROOT/sar_transformer-main"
# This is the exact root represented as /REMOTE/DATA in the running manual;
# do not append an extra sar_icsps26 component unless transfers use it too.
export SAR_DATA_WORK_ROOT="/SET/DATA_WORK_ROOT"

export NWPU_ROOT="$SAR_DATA_WORK_ROOT/raw/NWPU-RESISC45"
export UCM_ROOT="$SAR_DATA_WORK_ROOT/raw/UCMerced_LandUse/Images"
export REAL_ROOT="$SAR_DATA_WORK_ROOT/raw/real_sar_dataset"

# Frozen paper decision: do not transfer, auto-discover, evaluate, or report GT16.
# All GT16-based quasi-reference metrics are outside the paper result set.
export REAL_USE_GT16=0
unset REAL_GT16_ROOT

export NWPU_MASTER_MANIFEST="$SAR_DATA_WORK_ROOT/seed_manifests/nwpu_global_L_v2_dataset_manifest.json"
export REAL_SPLIT_MANIFEST="$SAR_DATA_WORK_ROOT/seed_manifests/real_split_grouped_seed42.json"

export PREP_ROOT="$SAR_DATA_WORK_ROOT/protocols/ICSPS26_FROZEN_v2"
export REAL_PROTOCOL_ROOT="$SAR_DATA_WORK_ROOT/protocols/real_icsps26_frozen_v2_no_gt16"
export RUN_ROOT="$SAR_DATA_WORK_ROOT/experiments_icsps26"
export SMOKE_ROOT="$SAR_DATA_WORK_ROOT/smoke/icsps26_$(date -u +%Y%m%dT%H%M%SZ)"
export PROFILE_ROOT="$SAR_DATA_WORK_ROOT/profile/icsps26_1000_$(date -u +%Y%m%dT%H%M%SZ)"
export SARBM3D_SMOKE_ROOT="$SAR_DATA_WORK_ROOT/smoke/sarbm3d_$(date -u +%Y%m%dT%H%M%SZ)"

export SAR_EXTERNAL_ROOT="$SAR_DATA_WORK_ROOT/external"
export SAR_CAM_ROOT="$SAR_EXTERNAL_ROOT/SAR-CAM"
export SAR_DEVICE=cuda
export SAR_WORKERS=4

# 25 GiB is a hard preflight floor, not a claim about the nominal 50-GB disk.
# Raise this if optional SAR-BM3D predictions or multiple seeds will be retained.
export SAR_MIN_FREE_GIB=25

# Optional: set this after `lsblk`/`df` if you want inventory to require a
# particular mounted filesystem device (example: /dev/vdb1).  It is left
# unset because the provider has not supplied the data-disk mount point.
# export SAR_EXPECTED_DATA_DEVICE="/dev/SET/ME"

# Formal default is seed 42. After the core evidence is complete, use "42 43 44"
# only for methods explicitly scheduled for multi-seed reporting.
export CORE_SEEDS="42"
export EVAL_SEEDS="42"
export INCLUDE_SAR_CAM=0

# Optional queue overrides, useful for seeds 43/44 after the complete seed-42
# matrix.  Leave unset for the default five-method core matrix.  Example:
# export GPU0_METHOD_SPECS="ours:full"
# export GPU1_METHOD_SPECS="transsar_v2:"
# export GPU0_EVAL_METHOD_SPECS="ours:full"
# export GPU1_EVAL_METHOD_SPECS="transsar_v2:"
# EVAL_METHOD_SPECS is the single-GPU evaluator override; do not set it when
# using 04_evaluate_synthetic_dualgpu.sh.
